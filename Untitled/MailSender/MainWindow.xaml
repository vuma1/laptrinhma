<Window x:Class="MailSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MailSender.Views"
        xmlns:dialogs="clr-namespace:MailSender.Views.Dialogs"
        mc:Ignorable="d"
        Title="Mail Sender" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, Roboto, Arial">

    <!-- Outer Window Border with Rounded Corners -->
    <Border Background="{StaticResource WindowBgBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <!-- 3 Main Vertical Regions: TitleBar, Content, StatusBar -->
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />  <!-- Custom Title Bar -->
                <RowDefinition Height="*" />   <!-- Sidebar + Main View -->
                <RowDefinition Height="32" />  <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- 1. CUSTOM TITLE BAR                            -->
            <!-- ============================================== -->
            <Border Grid.Row="0" Background="{StaticResource WindowBgBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Brand & Workspace Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Blue App Logo with Paper Plane -->
                        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6" Width="24" Height="24" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconPaperPlane}" Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Mail Sender" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="13" Foreground="#94A3B8" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Không gian cá nhân" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Window Control Buttons (Min, Max, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click">
                            <TextBlock Text="&#x2014;" FontSize="11" FontWeight="Bold" Margin="0,-4,0,0" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Click="Maximize_Click">
                            <TextBlock Text="&#x25A2;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" Click="Close_Click">
                            <TextBlock Text="&#x2715;" FontSize="11" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 2. SIDEBAR & MAIN VIEW HOST                    -->
            <!-- ============================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Category Title -->
                            <RowDefinition Height="*" />    <!-- Navigation Items -->
                            <RowDefinition Height="Auto" /> <!-- Profile Card -->
                        </Grid.RowDefinitions>

                        <!-- Category Title -->
                        <TextBlock Grid.Row="0" Text="KHÔNG GIAN LÀM VIỆC" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="16,16,16,10" />

                        <!-- Navigation Items -->
                        <StackPanel Grid.Row="1">
                            <!-- 1. Soạn thư -->
                            <RadioButton Style="{StaticResource SidebarNavStyle}" IsChecked="{Binding CurrentView, Converter={StaticResource EqualityToBool}, ConverterParameter=Compose}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Compose">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCompose}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="Soạn thư" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 2. Hàng loạt -->
                            <RadioButton Style="{StaticResource SidebarNavStyle}" IsChecked="{Binding CurrentView, Converter={StaticResource EqualityToBool}, ConverterParameter=BulkSend}"
                                         Command="{Binding NavigateCommand}" CommandParameter="BulkSend">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconEnvelope}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="Hàng loạt" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 3. Danh bạ -->
                            <RadioButton Style="{StaticResource SidebarNavStyle}" IsChecked="{Binding CurrentView, Converter={StaticResource EqualityToBool}, ConverterParameter=Contacts}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Contacts">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconContacts}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="Danh bạ" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 4. Lịch sử -->
                            <RadioButton Style="{StaticResource SidebarNavStyle}" IsChecked="{Binding CurrentView, Converter={StaticResource EqualityToBool}, ConverterParameter=History}"
                                         Command="{Binding NavigateCommand}" CommandParameter="History">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconHistory}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="Lịch sử" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- 5. Cài đặt -->
                            <RadioButton Style="{StaticResource SidebarNavStyle}" IsChecked="{Binding CurrentView, Converter={StaticResource EqualityToBool}, ConverterParameter=Settings}"
                                         Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSettings}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Text="Cài đặt" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Profile Card -->
                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Margin="12,0,12,14" Padding="12,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials Avatar -->
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#EEF2FF" Margin="0,0,10,0">
                                        <TextBlock Text="MA" FontSize="12.5" FontWeight="Bold" Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Nguyễn Minh Anh" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Tài khoản Gmail" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Connection Status Indicator -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconCheckCircle}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ProfileConnectionStatus}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Main Content Area -->
                <Grid Grid.Column="1" Background="{StaticResource WindowBgBrush}">
                    <!-- View 1: Soạn thư -->
                    <views:ComposeView Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Compose}" />

                    <!-- View 2: Hàng loạt -->
                    <views:BulkSendView Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibility}, ConverterParameter=BulkSend}" />

                    <!-- View 3: Danh bạ -->
                    <views:ContactsView Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Contacts}" />

                    <!-- View 4: Lịch sử -->
                    <views:HistoryView Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibility}, ConverterParameter=History}" />

                    <!-- View 5: Cài đặt -->
                    <views:SettingsView Visibility="{Binding CurrentView, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Settings}" />
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- 3. BOTTOM STATUS BAR                           -->
            <!-- ============================================== -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid>
                    <TextBlock Text="Mail Sender · Lập trình mạng" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Kết nối được mã hóa · STARTTLS" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- 4. MODAL OVERLAY BACKDROP LAYER                -->
            <!-- ============================================== -->
            <Grid Grid.RowSpan="3" Background="{StaticResource ModalBackdropBrush}"
                  MouseDown="Backdrop_MouseDown">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveModal}" Value="None">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dialog 1: Schedule -->
                <dialogs:ScheduleDialog HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Schedule}" />

                <!-- Dialog 2: Contact Edit / Add -->
                <dialogs:ContactEditDialog HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=ContactEdit}" />

                <!-- Dialog 3: History Error Detail -->
                <dialogs:ErrorDetailDialog HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=ErrorDetail}" />

                <!-- Dialog 4: Notification Dialogs (Success, NetworkError, AuthError, FileLimit) -->
                <dialogs:NotificationDialog HorizontalAlignment="Center" VerticalAlignment="Center">
                    <dialogs:NotificationDialog.Style>
                        <Style TargetType="dialogs:NotificationDialog">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveModal}" Value="Success">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveModal}" Value="NetworkError">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveModal}" Value="AuthError">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ActiveModal}" Value="FileLimit">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </dialogs:NotificationDialog.Style>
                </dialogs:NotificationDialog>
            </Grid>
        </Grid>
    </Border>
</Window>
