<UserControl x:Class="MailSender.Views.ComposeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Soạn thư" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Một lời mời chỉn chu, sẵn sàng gửi đi." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Draft status -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconCheckCircle}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Đã lưu bản nháp · 09:41" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Main Card Form -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Từ -->
                    <RowDefinition Height="Auto" /> <!-- Đến -->
                    <RowDefinition Height="Auto" /> <!-- Cc (Optional) -->
                    <RowDefinition Height="Auto" /> <!-- Bcc (Optional) -->
                    <RowDefinition Height="Auto" /> <!-- Chủ đề -->
                    <RowDefinition Height="Auto" /> <!-- Toolbar -->
                    <RowDefinition Height="*" />    <!-- Body -->
                    <RowDefinition Height="Auto" /> <!-- Attachments -->
                </Grid.RowDefinitions>

                <!-- 1. Row: Từ -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Từ" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SenderAccounts}"
                                  Text="{Binding SmtpAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" BorderThickness="0" Background="Transparent"
                                  FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}"
                                  VerticalContentAlignment="Center" ToolTip="Chọn hoặc nhập tài khoản Gmail gửi thư"
                                  GotFocus="SenderAccount_GotFocus" />
                    </Grid>
                </Border>

                <!-- 2. Row: Đến -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Đến" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center" />

                        <!-- Normal Recipients Chips -->
                        <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding RecipientChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PrimarySoftBgBrush}" BorderBrush="{StaticResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,2,8,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconCheck}" Fill="{StaticResource PrimaryBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" StrokeThickness="1" />
                                                <TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,0" Margin="4,0,0,0" Height="16" Width="16"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveRecipientCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource PrimaryBrush}" Width="8" Height="8" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add email inline input -->
                            <TextBox Width="160" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13"
                                     Text="{Binding NewRecipientInput, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="NewRecipientInput_KeyDown"
                                     ToolTip="Gõ email và nhấn Enter để thêm" Margin="4,0" />
                        </WrapPanel>

                        <!-- Right buttons: Cc, Bcc, Address book -->
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Cc" Style="{StaticResource GhostButton}" Margin="2,0" Foreground="{StaticResource PrimaryBrush}" FontSize="13" FontWeight="Medium"
                                    Command="{Binding ToggleCcCommand}" />
                            <Button Content="Bcc" Style="{StaticResource GhostButton}" Margin="2,0" Foreground="{StaticResource PrimaryBrush}" FontSize="13" FontWeight="Medium"
                                    Command="{Binding ToggleBccCommand}" />
                            <Button Style="{StaticResource GhostButton}" Margin="2,0" ToolTip="Chọn từ danh bạ"
                                    Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.NavigateCommand}" CommandParameter="Contacts">
                                <Path Data="{StaticResource IconAddressBook}" Fill="{StaticResource TextMutedBrush}" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Row: Cc (Visible on toggle) -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                        Visibility="{Binding IsCcVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cc" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CcInput}" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Row: Bcc (Visible on toggle) -->
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                        Visibility="{Binding IsBccVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bcc" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding BccInput}" BorderThickness="0" Background="Transparent" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 3. Row: Chủ đề -->
                <Border Grid.Row="4" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Chủ đề" Foreground="{StaticResource TextMutedBrush}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Subject}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 4. Row: Formatting Toolbar -->
                <Border Grid.Row="5" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Background="#FAFAFA" Padding="16,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Margin="0,0,2,0" Click="FormatBold_Click" ToolTip="In đậm (Bold)">
                                <TextBlock Text="B" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Margin="0,0,2,0" Click="FormatItalic_Click" ToolTip="In nghiêng (Italic)">
                                <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Margin="0,0,2,0" Click="FormatUnderline_Click" ToolTip="Gạch chân (Underline)">
                                <TextBlock Text="U" TextDecorations="Underline" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Margin="0,0,6,0" Click="FormatLink_Click" ToolTip="Chèn liên kết">
                                <Path Data="{StaticResource IconLink}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" />
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderLightBrush}" Margin="4,0,8,0" />

                            <Button Style="{StaticResource GhostButton}" Padding="8,4"
                                    Command="{Binding InsertVariableCommand}" CommandParameter="{}{Name}"
                                    ToolTip="Chèn biến họ tên người nhận">
                                <TextBlock Text="+ Chèn {Name}" Foreground="{StaticResource PrimaryBrush}" FontSize="13" FontWeight="Medium" />
                            </Button>
                        </StackPanel>

                        <!-- Right Format Switcher: Văn bản | HTML -->
                        <Border HorizontalAlignment="Right" Background="#F1F5F9" CornerRadius="6" Padding="2" Cursor="Hand" MouseDown="ToggleFormatMode_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtmlMode}" Value="True">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="Văn bản" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="10,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHtmlMode}" Value="True">
                                                    <Setter Property="Background" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="HTML" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 5. Row: Message Body -->
                <TextBox x:Name="BodyTextBox" Grid.Row="6" Text="{Binding BodyContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" Padding="16" FontSize="13.5"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI" KeyDown="BodyTextBox_KeyDown" />

                <!-- 6. Row: Attachments & Drop Area -->
                <Border Grid.Row="7" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <StackPanel>
                        <!-- Attached Chips -->
                        <WrapPanel Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconFile}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding FileName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileSize}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,0" Margin="6,0,0,0" Height="16" Width="16"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveAttachmentCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="8" Height="8" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- Dropzone Area -->
                        <Border BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1" CornerRadius="6" Background="#FAFAFA" Padding="12,10"
                                Cursor="Hand" MouseDown="Dropzone_MouseDown" AllowDrop="True" Drop="Dropzone_Drop">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconPaperclip}" Fill="{StaticResource TextMutedBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Kéo thả tệp vào đây hoặc " FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="chọn tệp" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" TextDecorations="Underline" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Storage Quota Bar -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding AttachmentQuotaPercent, Mode=OneWay}" Maximum="100" Height="4" Style="{StaticResource ModernProgressBar}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding AttachmentQuotaText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Send button -->
                <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"
                        Command="{Binding SendMailCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPaperPlane}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Gửi thư" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Schedule button -->
                <Button Style="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Margin="10,0,0,0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.ShowModalCommand}" CommandParameter="Schedule">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconClock}" Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Hẹn giờ" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Hint text -->
                <TextBlock Text="Ctrl + Enter để gửi · 2 người nhận hợp lệ" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>

            <!-- Trash delete icon -->
            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="36" Height="36" Padding="0" ToolTip="Xóa bản nháp"
                    Command="{Binding DeleteDraftCommand}">
                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextMutedBrush}" Width="15" Height="15" Stretch="Uniform" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
