<UserControl x:Class="MailSender.Views.BulkSendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="32,24,32,20">
        <!-- ============================================== -->
        <!-- STEP 1: KIỂM TRA DANH SÁCH                     -->
        <!-- ============================================== -->
        <Grid Visibility="{Binding BulkStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=1}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- File Card -->
                <RowDefinition Height="Auto" /> <!-- Warning Alert -->
                <RowDefinition Height="*" />    <!-- Verification Table -->
                <RowDefinition Height="Auto" /> <!-- Bottom Split: Settings & Preview -->
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gửi hàng loạt" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Kiểm tra người nhận trước khi gửi thư cá nhân hóa." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Step badge -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PrimarySoftBgBrush}"
                        BorderBrush="{StaticResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Bước 1 / 2 · Kiểm tra" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- File Source Card -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource PrimarySoftBgBrush}" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconFile}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BulkFileName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding BulkFileStats}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Command="{Binding ImportBulkFileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconUpload}" Fill="{StaticResource TextPrimaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Nhập CSV / TXT" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Warning Alert Banner -->
            <Border Grid.Row="2" Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSettings}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding BulkAlertSummary}"
                               FontSize="13" FontWeight="Medium" Foreground="{StaticResource WarningTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Recipients Verification Table -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tên người nhận" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="Kết quả kiểm tra" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="Thao tác" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- Table Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BulkVerifyList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tên -->
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Email -->
                                            <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Kết quả kiểm tra Badge -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <!-- Valid (Green) -->
                                                <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Valid}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                </Border>
                                                <!-- Duplicate (Amber) -->
                                                <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Duplicate}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                                </Border>
                                                <!-- Invalid (Red) -->
                                                <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Invalid}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Thao tác -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ActionText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                                           Visibility="{Binding IsActionLink, Converter={StaticResource InvertBoolToVisibility}}" />
                                                <Button Style="{StaticResource GhostButton}" Padding="0"
                                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.FixInvalidRecipientCommand}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActionLink, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding ActionText}" FontSize="13" Foreground="{StaticResource PrimaryBrush}"
                                                               Cursor="Hand" TextDecorations="Underline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bottom Section: Cách gửi, Xem trước & Gửi -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Send Options -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cách gửi" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <RadioButton Content="Gửi riêng từng người" Style="{StaticResource ModernRadioButton}" IsChecked="{Binding IsSendSingle}" Margin="0,0,16,0" />
                        <RadioButton Content="Bcc" Style="{StaticResource ModernRadioButton}" IsChecked="{Binding IsSendSingle, Converter={StaticResource InvertBoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="Gửi riêng: cá nhân hóa theo tên.&#x0a;Bcc: một thư chung, ẩn danh sách người nhận." FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" LineHeight="18" Margin="0,0,0,12" />
                    <TextBlock Text="Trường cá nhân hóa: {Name} &#x2192; cột Tên · 2 tệp đính kèm" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- Right: Preview Box & Action -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview card -->
                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="XEM TRƯỚC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                                <Path HorizontalAlignment="Right" Data="{StaticResource IconEye}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Grid>
                            <TextBlock Text="{Binding Subject}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding BodyContent}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Send button -->
                    <Button Grid.Row="1" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"
                            Command="{Binding StartBulkSendingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPaperPlane}" Fill="White" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding BulkValidCount, StringFormat='Gửi cho {0} người hợp lệ'}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================== -->
        <!-- STEP 2: ĐANG GỬI THƯ                           -->
        <!-- ============================================== -->
        <Grid Visibility="{Binding BulkStep, Converter={StaticResource EqualityToVisibility}, ConverterParameter=2}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Big Progress Card -->
                <RowDefinition Height="Auto" /> <!-- Sub-header stats -->
                <RowDefinition Height="*" />    <!-- Sending Table -->
                <RowDefinition Height="Auto" /> <!-- Safe note banner -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Đang gửi thư" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding Subject}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Step badge -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PrimarySoftBgBrush}"
                        BorderBrush="{StaticResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Bước 2 / 2 · Đang gửi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Large Progress Card -->
            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Top stats: Icon + count, Percentage -->
                    <Grid Margin="0,0,0,12">
                        <!-- Left indicator -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Sending state spinner / circle -->
                            <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                                  Visibility="{Binding IsBulkPaused, Converter={StaticResource InvertBoolToVisibility}}" />
                            <!-- Paused badge -->
                            <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,10,0"
                                    Visibility="{Binding IsBulkPaused, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="🕒 Đã tạm dừng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                            </Border>

                            <TextBlock Text="{Binding BulkSentText}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Right Percentage -->
                        <TextBlock HorizontalAlignment="Right" Text="{Binding BulkProgressText}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Thick Progress Bar -->
                    <ProgressBar Height="8" Value="{Binding BulkProgressPercent}" Maximum="100" Style="{StaticResource ModernProgressBar}" Margin="0,0,0,12" />

                    <!-- Sub stats -->
                    <Grid>
                        <TextBlock Text="{Binding BulkStatsText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding BulkRunningTimeText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sub Header Info -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="{Binding BulkFileName}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" Text="{Binding BulkAlertSummary}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>

            <!-- Sending Progress Table -->
            <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Người nhận" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="Email" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="Trạng thái" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="Tiến trình" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BulkSendingList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Tên -->
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Email -->
                                            <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                            <!-- Trạng thái Pill -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <!-- Sent (Green) -->
                                                <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding SendingState, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Sent}">
                                                    <TextBlock Text="{Binding SendingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                                </Border>
                                                <!-- Sending (Blue) -->
                                                <Border Background="{StaticResource PrimarySoftBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding SendingState, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Sending}">
                                                    <TextBlock Text="{Binding SendingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                                </Border>
                                                <!-- Pending (Gray) -->
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                        Visibility="{Binding SendingState, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Pending}">
                                                    <TextBlock Text="{Binding SendingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Tiến trình Bar -->
                                            <Grid Grid.Column="3" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <ProgressBar Grid.Column="0" Height="6" Maximum="100" Value="{Binding ProgressPercent}" Style="{StaticResource ModernProgressBar}" VerticalAlignment="Center" />

                                                <!-- Progress text percentage -->
                                                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Info Safe Banner -->
            <Border Grid.Row="4" Background="{StaticResource PrimarySoftBgBrush}" BorderBrush="{StaticResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Bạn có thể tạm dừng an toàn. Thư đã gửi không bị gửi lại khi tiếp tục." FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Bottom Actions -->
            <Grid Grid.Row="5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pause/Resume Button -->
                    <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="18,0"
                            Command="{Binding ToggleBulkPauseCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Pause icon if running -->
                            <Path Data="{StaticResource IconPause}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Visibility="{Binding IsBulkPaused, Converter={StaticResource InvertBoolToVisibility}}" />
                            <!-- Play icon if paused -->
                            <Path Data="{StaticResource IconPlay}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Visibility="{Binding IsBulkPaused, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Text="Tạm dừng" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsBulkPaused, Converter={StaticResource InvertBoolToVisibility}}" />
                            <TextBlock Text="Tiếp tục" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Visibility="{Binding IsBulkPaused, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <!-- Cancel button -->
                    <Button Style="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Margin="10,0,0,0"
                            Command="{Binding CancelBulkSendingCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Hủy lượt gửi" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right note -->
                <TextBlock HorizontalAlignment="Right" Text="Giữ ứng dụng mở trong khi gửi" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
