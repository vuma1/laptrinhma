<UserControl x:Class="MailSender.Views.Dialogs.ScheduleDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="24"
            Effect="{StaticResource ModalShadowEffect}">
        <StackPanel>
            <!-- Title Bar -->
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Hẹn giờ gửi thư" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Subtitle -->
            <TextBlock Text="{Binding Subject}"
                       FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="18" Margin="0,0,0,18" />

            <!-- Form: Date & Time -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Ngày gửi -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ngày gửi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconContacts}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding ScheduleDate, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Width="120" />
                            </StackPanel>
                            <Path HorizontalAlignment="Right" Data="{StaticResource IconChevronDown}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Giờ gửi -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Giờ gửi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="10,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconClock}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Width="100" />
                            </StackPanel>
                            <Path HorizontalAlignment="Right" Data="{StaticResource IconChevronDown}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Timezone info -->
            <TextBlock Text="Múi giờ: (UTC+07:00) Hà Nội, Việt Nam" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

            <!-- Warning Box -->
            <Border Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconAlert}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0" />
                    <TextBlock Grid.Column="1" Text="Giữ máy tính bật, ứng dụng mở và có mạng vào giờ gửi. Lịch đã lưu sẽ xuất hiện trong Lịch sử."
                               FontSize="12.5" Foreground="{StaticResource WarningTextBrush}" LineHeight="18" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Footer Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0"
                        Command="{Binding ConfirmScheduleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconClock}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Xác nhận lịch gửi" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
