<UserControl x:Class="MailSender.Views.Dialogs.NotificationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="24"
            Effect="{StaticResource ModalShadowEffect}">
        <StackPanel>
            <!-- ============================================== -->
            <!-- 1. GỬI THÀNH CÔNG                              -->
            <!-- ============================================== -->
            <StackPanel Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Success}">
                <!-- Title Row -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="14" Width="28" Height="28" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeThickness="1.5" />
                        </Border>
                        <TextBlock Text="Thư đã được gửi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Text="Lời mời báo cáo đồ án đã được gửi đến An và Bình." FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                <TextBlock Text="2 người nhận · 2 tệp đính kèm. Bạn có thể xem lại kết quả trong Lịch sử gửi." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,24" />

                <!-- Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                    <Button Content="Xem lịch sử" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0"
                            Click="GoToHistory_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================== -->
            <!-- 2. LỖI MẠNG                                    -->
            <!-- ============================================== -->
            <StackPanel Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=NetworkError}">
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconWifiOff}" Fill="{StaticResource ErrorBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Chưa thể kết nối mạng" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Text="Không thể liên lạc với máy chủ email. Hãy kiểm tra Wi-Fi hoặc cáp mạng rồi thử lại." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Thư chưa được gửi. Nội dung và tệp đính kèm vẫn được giữ nguyên trong bản nháp." FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,24" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Để sau" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                    <Button Content="Thử lại" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0"
                            Command="{Binding TestConnectionCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================== -->
            <!-- 3. SAI MẬT KHẨU                                -->
            <!-- ============================================== -->
            <StackPanel Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=AuthError}">
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconKey}" Fill="{StaticResource ErrorBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Không thể đăng nhập SMTP" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Text="Máy chủ từ chối tài khoản hoặc mật khẩu. Hãy kiểm tra địa chỉ gửi và mật khẩu ứng dụng trong Cài đặt." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Với Gmail, dùng mật khẩu ứng dụng thay vì mật khẩu đăng nhập. Mã phản hồi: 535 · Xác thực thất bại." FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,24" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                    <Button Content="Mở cài đặt" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0"
                            Click="GoToSettings_Click" />
                </StackPanel>
            </StackPanel>

            <!-- ============================================== -->
            <!-- 4. TỆP VƯỢT GIỚI HẠN                           -->
            <!-- ============================================== -->
            <StackPanel Visibility="{Binding ActiveModal, Converter={StaticResource EqualityToVisibility}, ConverterParameter=FileLimit}">
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource WarningBgBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconFileWarning}" Fill="{StaticResource WarningBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Tệp đính kèm quá lớn" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                        <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </Grid>

                <TextBlock Text="Tệp đính kèm đã vượt giới hạn 25 MB cho toàn bộ tệp đính kèm." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Tệp này chưa được thêm. Hãy nén tệp, chọn tệp nhỏ hơn hoặc chia sẻ một liên kết trong nội dung thư." FontSize="13" Foreground="{StaticResource TextMutedBrush}" LineHeight="19" TextWrapping="Wrap" Margin="0,0,0,24" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                            Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                    <Button Content="Chọn tệp khác" Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0"
                            Click="ChooseOtherFile_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
