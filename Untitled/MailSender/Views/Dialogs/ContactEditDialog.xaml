<UserControl x:Class="MailSender.Views.Dialogs.ContactEditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="460">
    <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="12" Padding="24"
            Effect="{StaticResource ModalShadowEffect}">
        <StackPanel>
            <!-- Title Bar -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimarySoftBgBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconContacts}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding DialogContactTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}">
                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Field 1: Họ và tên -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Họ và tên *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding EditingContactName, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Field 2: Địa chỉ email -->
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Địa chỉ email *" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding EditingContactEmail, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!-- Field 3: Nhóm -->
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="Nhóm" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ComboBox Height="38" Style="{StaticResource ModernComboBox}"
                          SelectedValue="{Binding EditingContactGroup, Mode=TwoWay}" SelectedValuePath="Content">
                    <ComboBoxItem Content="Nhóm chung" />
                </ComboBox>
            </StackPanel>

            <!-- Footnote -->
            <TextBlock Text="Tên này được dùng cho trường cá nhân hóa {Name}." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,24" />

            <!-- Footer Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Height="38" Padding="18,0" Margin="0,0,10,0"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.CloseModalCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="16,0"
                        Command="{Binding SaveContactDialogCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="White" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" StrokeThickness="1" />
                        <TextBlock Text="Lưu liên hệ" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
