<UserControl x:Class="MailSender.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Provider Selector Cards -->
            <RowDefinition Height="*" />    <!-- Main Grid: Form + Guide -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Cài đặt SMTP" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Kết nối tài khoản email để bắt đầu gửi thư an toàn." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- Provider Presets Cards (3 Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Gmail -->
            <Border Grid.Column="0" CornerRadius="8" BorderThickness="1.5" Cursor="Hand" Padding="16,14" MouseDown="SelectGmail_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProvider}" Value="Gmail">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5" Fill="White" />
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" />
                        </Grid>
                        <TextBlock Text="Gmail" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="smtp.gmail.com · 587 · STARTTLS" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 2: Outlook -->
            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1" Cursor="Hand" Padding="16,14" MouseDown="SelectOutlook_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProvider}" Value="Outlook">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Stroke="{StaticResource BorderHoverBrush}" StrokeThickness="1.5" Fill="White" />
                        </Grid>
                        <TextBlock Text="Outlook" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="smtp.office365.com · 587 · STARTTLS" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- Card 3: LAN nội bộ -->
            <Border Grid.Column="4" CornerRadius="8" BorderThickness="1" Cursor="Hand" Padding="16,14" MouseDown="SelectLan_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedProvider}" Value="LAN">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBgBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse Stroke="{StaticResource BorderHoverBrush}" StrokeThickness="1.5" Fill="White" />
                        </Grid>
                        <TextBlock Text="LAN nội bộ" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="192.168.1.10 · 25 · Không TLS" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Grid: Form (Left) & Tips/Banner (Right) -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left Form Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="Thông tin kết nối" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Row 1: Host & Port -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- Host -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Máy chủ SMTP" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <!-- Port -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cổng" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Security -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Bảo mật kết nối" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox Height="38" Style="{StaticResource ModernComboBox}"
                                  SelectedValue="{Binding SmtpSecurity, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="STARTTLS (khuyên dùng)" IsSelected="True" />
                            <ComboBoxItem Content="SSL / TLS" />
                            <ComboBoxItem Content="Không bảo mật (None)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Row 3: Account -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Tài khoản gửi" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource ModernTextBox}" Height="38" Text="{Binding SmtpAccount, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- Row 4: Password with Eye Toggle -->
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Mật khẩu ứng dụng" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Height="38" Padding="12,0">
                            <Grid>
                                <TextBox BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                         Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="6,2" VerticalAlignment="Center" Click="TogglePasswordVisibility_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconEye}" Fill="{StaticResource TextMutedBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Hiện" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowPassword}" Value="True">
                                                            <Setter Property="Text" Value="Ẩn" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <TextBlock Text="Không dùng mật khẩu đăng nhập Gmail thông thường." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Test Button & Status -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="16,0"
                                Command="{Binding TestConnectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlug}" Fill="{StaticResource TextPrimaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Test kết nối" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsConnectionTested, Converter={StaticResource BoolToVisibility}}">
                            <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" StrokeThickness="1" />
                            <TextBlock Text="{Binding LastTestedTimeText}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Column: Status Banner & Setup Guide -->
            <StackPanel Grid.Column="2">
                <!-- Success Banner -->
                <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource IconCheckCircle}" Fill="{StaticResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <TextBlock Grid.Column="1" Text="Kết nối thành công. Máy chủ đã xác thực tài khoản và sẵn sàng gửi thư."
                                   FontSize="13" FontWeight="Medium" Foreground="{StaticResource SuccessTextBrush}" LineHeight="19" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Security & Setup Guide Card -->
                <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <!-- Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconShieldCheck}" Fill="{StaticResource PrimaryBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Thiết lập đúng, gửi an toàn" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Step 1: Gmail -->
                        <TextBlock Text="Gmail: bật xác minh 2 bước, sau đó tạo mật khẩu ứng dụng." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Button Style="{StaticResource GhostButton}" Padding="0" HorizontalAlignment="Left" Margin="0,0,0,14"
                                Command="{Binding OpenGooglePasswordGuideCommand}">
                            <TextBlock Text="Hướng dẫn tạo mật khẩu &#x2197;" FontSize="12.5" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" />
                        </Button>

                        <!-- Step 2: Outlook -->
                        <TextBlock Text="Outlook doanh nghiệp có thể yêu cầu OAuth 2.0 hoặc quyền SMTP AUTH từ quản trị viên; không phải tài khoản nào cũng dùng mật khẩu ứng dụng."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Step 3: LAN -->
                        <TextBlock Text="LAN: chỉ chọn không TLS trong mạng nội bộ tin cậy và theo cấu hình quản trị viên."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="18" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom Actions Row -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Height="40" Padding="20,0"
                        Command="{Binding SaveSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="White" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" StrokeThickness="1" />
                        <TextBlock Text="Lưu cấu hình" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Margin="10,0,0,0"
                        Command="{Binding CancelSettingsCommand}">
                    <TextBlock Text="Hủy thay đổi" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
                </Button>
            </StackPanel>

            <!-- Right safety footnote -->
            <TextBlock HorizontalAlignment="Right" Text="Mật khẩu được lưu bảo vệ trên máy này." FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
