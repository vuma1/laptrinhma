<UserControl x:Class="MailSender.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="Auto" /> <!-- Filters -->
            <RowDefinition Height="Auto" /> <!-- Counters Pill Bar -->
            <RowDefinition Height="*" />    <!-- Table or Empty Card -->
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lịch sử gửi" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <!-- Subtitle when filled -->
                <TextBlock Text="Theo dõi thư đã gửi, thư lỗi và lịch gửi sắp tới." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                           Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}" />
                <!-- Subtitle when empty -->
                <TextBlock Text="Mọi lần gửi và lịch hẹn của bạn sẽ xuất hiện tại đây." FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                           Visibility="{Binding HasHistory, Converter={StaticResource InvertBoolToVisibility}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Export History Button -->
                <Button Style="{StaticResource SecondaryButton}" Height="38" Padding="14,0"
                        Command="{Binding ExportHistoryCsvCommand}"
                        IsEnabled="{Binding HasHistory}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}" Fill="{StaticResource TextPrimaryBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Xuất lịch sử" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Filters Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="6" Height="38" Margin="0,0,12,0" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextPlaceholderBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                             Text="{Binding SearchHistoryText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <!-- Date dropdown -->
            <ComboBox Grid.Column="1" Width="170" Height="38" Margin="0,0,10,0" Style="{StaticResource ModernComboBox}">
            <ComboBoxItem Content="Tất cả thời gian" IsSelected="True" />
                <ComboBoxItem Content="Hôm nay" />
            </ComboBox>

            <!-- Status dropdown filter -->
            <ComboBox Grid.Column="2" Width="150" Height="38" Style="{StaticResource ModernComboBox}"
                      SelectedValue="{Binding SelectedHistoryStatusFilter, Mode=TwoWay}" SelectedValuePath="Content">
                <ComboBoxItem Content="Tất cả trạng thái" IsSelected="True" />
                <ComboBoxItem Content="Thành công" />
                <ComboBoxItem Content="Lỗi SMTP" />
                <ComboBoxItem Content="Chờ hẹn giờ" />
            </ComboBox>
        </Grid>

        <!-- Filter Count Badges (only when filled) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Bộ lọc:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

            <!-- 4 thành công -->
            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                <TextBlock Text="{Binding HistorySuccessCount, StringFormat='✓ {0} thành công'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
            </Border>

            <!-- 1 lỗi -->
            <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                <TextBlock Text="{Binding HistoryErrorCount, StringFormat='⛔ {0} lỗi'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
            </Border>

            <!-- 1 chờ hẹn giờ -->
            <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="8,3">
                <TextBlock Text="{Binding HistoryScheduledCount, StringFormat='🕒 {0} chờ hẹn giờ'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
            </Border>
        </StackPanel>

        <!-- ========================================== -->
        <!-- STATE A: HISTORY DATA TABLE                -->
        <!-- ========================================== -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Thời gian" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Người nhận / Chủ đề" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Trạng thái" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="" />
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredHistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thời gian -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimePrimary}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding TimeSecondary}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Người nhận / Chủ đề -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Recipient}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Subject}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Trạng thái Badge -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <!-- Success (Green) -->
                                            <Border Background="{StaticResource SuccessBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                    Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Success}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                            </Border>
                                            <!-- Error (Red) -->
                                            <Border Background="{StaticResource ErrorBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                    Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Error}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" />
                                            </Border>
                                            <!-- Scheduled (Amber) -->
                                            <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                    Visibility="{Binding Status, Converter={StaticResource EqualityToVisibility}, ConverterParameter=Scheduled}">
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Action Link -->
                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- Normal Details Button -->
                                            <Button Style="{StaticResource GhostButton}" Padding="4,2"
                                                    Visibility="{Binding IsError, Converter={StaticResource InvertBoolToVisibility}}"
                                                    Click="ViewDetail_Click">
                                                <TextBlock Text="{Binding ActionText}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" />
                                            </Button>

                                            <!-- Error Details Button (Opens Error Modal) -->
                                            <Button Style="{StaticResource GhostButton}" Padding="4,2"
                                                    Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.OpenErrorDetailCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding ActionText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#FAFAFA" Padding="16,10">
                    <Grid>
                        <TextBlock Text="Hiển thị theo bộ lọc thời gian · Giờ Việt Nam" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Text="Trang 1 / 1" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- STATE B: EMPTY HISTORY                     -->
        <!-- ========================================== -->
        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding HasHistory, Converter={StaticResource InvertBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60">
                <!-- Large Icon Circle / Box -->
                <Border Background="{StaticResource PrimarySoftBgBrush}" Width="80" Height="80" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Path Data="{StaticResource IconEnvelope}" Fill="{StaticResource PrimaryBrush}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Subtitle -->
                <TextBlock Text="Chưa có thư nào được gửi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Bắt đầu với một lời nhắn đầu tiên.&#x0a;Sau khi gửi, bạn có thể kiểm tra kết quả hoặc xem lại lỗi tại đây."
                           FontSize="13.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" LineHeight="20" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Action Button -->
                <Button Style="{StaticResource PrimaryButton}" Height="38" Padding="18,0" HorizontalAlignment="Center" Margin="0,0,0,16"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.NavigateCommand}" CommandParameter="Compose">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCompose}" Fill="White" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Soạn thư đầu tiên" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Schedule note -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Thư hẹn giờ cũng được theo dõi trong lịch sử" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
