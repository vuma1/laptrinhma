<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Window & Layout Backgrounds -->
    <Color x:Key="WindowBgColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />

    <Color x:Key="SidebarBgColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />

    <Color x:Key="CardBgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />

    <Color x:Key="BorderLightColor">#E2E8F0</Color>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />

    <Color x:Key="BorderHoverColor">#CBD5E1</Color>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}" />

    <!-- Brand / Primary Accent -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />

    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />

    <Color x:Key="PrimaryPressedColor">#1E40AF</Color>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />

    <Color x:Key="PrimarySoftBgColor">#EFF6FF</Color>
    <SolidColorBrush x:Key="PrimarySoftBgBrush" Color="{StaticResource PrimarySoftBgColor}" />

    <Color x:Key="PrimarySoftBorderColor">#DBEAFE</Color>
    <SolidColorBrush x:Key="PrimarySoftBorderBrush" Color="{StaticResource PrimarySoftBorderColor}" />

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#0F172A</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#475569</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#64748B</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="TextPlaceholderColor">#94A3B8</Color>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholderColor}" />

    <!-- Success -->
    <Color x:Key="SuccessColor">#16A34A</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <Color x:Key="SuccessBgColor">#ECFDF5</Color>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />

    <Color x:Key="SuccessBorderColor">#A7F3D0</Color>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="{StaticResource SuccessBorderColor}" />

    <Color x:Key="SuccessTextColor">#065F46</Color>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />

    <!-- Warning / Amber -->
    <Color x:Key="WarningColor">#D97706</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <Color x:Key="WarningBgColor">#FFFBEB</Color>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />

    <Color x:Key="WarningBorderColor">#FDE68A</Color>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}" />

    <Color x:Key="WarningTextColor">#92400E</Color>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />

    <!-- Danger / Error -->
    <Color x:Key="ErrorColor">#DC2626</Color>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />

    <Color x:Key="ErrorBgColor">#FEF2F2</Color>
    <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />

    <Color x:Key="ErrorBorderColor">#FECACA</Color>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}" />

    <Color x:Key="ErrorTextColor">#991B1B</Color>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />

    <!-- Modal backdrop -->
    <Color x:Key="ModalBackdropColor">#66000000</Color>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="{StaticResource ModalBackdropColor}" />
</ResourceDictionary>

